{
  "openapi": "3.0.0",
  "info": {
    "title": "Explore Mozambique API",
    "version": "1.0.0",
    "description": "REST API to discover and manage tourist, cultural, historical, natural and recreational places in Mozambique. Two collections (places, reviews) with full CRUD, server-side validation and MongoDB persistence."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same server that serves this page (works on localhost and on Render)"
    }
  ],
  "tags": [
    {
      "name": "Places",
      "description": "CRUD for places"
    },
    {
      "name": "Reviews",
      "description": "CRUD for reviews"
    },
    {
      "name": "System",
      "description": "Utilities"
    }
  ],
  "paths": {
    "/places": {
      "get": {
        "tags": [
          "Places"
        ],
        "summary": "List all places",
        "description": "Returns every place stored in MongoDB.",
        "responses": {
          "200": {
            "description": "List of places",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlacesList"
                },
                "example": {
                  "success": true,
                  "count": 1,
                  "data": [
                    {
                      "name": "Ponta do Ouro",
                      "description": "A popular coastal destination in southern Mozambique.",
                      "city": "Ponta do Ouro",
                      "province": "Maputo",
                      "type": "beach",
                      "averageCost": 2000,
                      "rating": 4.6,
                      "latitude": -26.845,
                      "longitude": 32.885,
                      "openingHours": "Open 24 hours",
                      "featured": true,
                      "_id": "665f1a2b3c4d5e6f7a8b9c0d",
                      "createdAt": "2026-10-03T08:00:00.000Z",
                      "updatedAt": "2026-10-03T08:00:00.000Z",
                      "__v": 0
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Places"
        ],
        "summary": "Create a place",
        "description": "Creates a new place. Server-side validation is applied; invalid data returns 400 and nothing is saved.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceInput"
              },
              "example": {
                "name": "Ponta do Ouro",
                "description": "A popular coastal destination in southern Mozambique.",
                "city": "Ponta do Ouro",
                "province": "Maputo",
                "type": "beach",
                "averageCost": 2000,
                "rating": 4.6,
                "latitude": -26.845,
                "longitude": 32.885,
                "openingHours": "Open 24 hours",
                "featured": true
              },
              "examples": {
                "valid": {
                  "summary": "Valid request",
                  "value": {
                    "name": "Ponta do Ouro",
                    "description": "A popular coastal destination in southern Mozambique.",
                    "city": "Ponta do Ouro",
                    "province": "Maputo",
                    "type": "beach",
                    "averageCost": 2000,
                    "rating": 4.6,
                    "latitude": -26.845,
                    "longitude": 32.885,
                    "openingHours": "Open 24 hours",
                    "featured": true
                  }
                },
                "invalid": {
                  "summary": "Invalid request (returns 400)",
                  "value": {
                    "name": "A",
                    "description": "Short",
                    "province": "Maputo",
                    "type": "invalid-type",
                    "averageCost": -100,
                    "rating": 10
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Place created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlacesSingle"
                },
                "example": {
                  "success": true,
                  "message": "Place created successfully",
                  "data": {
                    "name": "Ponta do Ouro",
                    "description": "A popular coastal destination in southern Mozambique.",
                    "city": "Ponta do Ouro",
                    "province": "Maputo",
                    "type": "beach",
                    "averageCost": 2000,
                    "rating": 4.6,
                    "latitude": -26.845,
                    "longitude": 32.885,
                    "openingHours": "Open 24 hours",
                    "featured": true,
                    "_id": "665f1a2b3c4d5e6f7a8b9c0d",
                    "createdAt": "2026-10-03T08:00:00.000Z",
                    "updatedAt": "2026-10-03T08:00:00.000Z",
                    "__v": 0
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Validation failed",
                  "errors": [
                    "Name must be at least 3 characters",
                    "Description must be at least 10 characters",
                    "City is required",
                    "Type must be one of: beach, national-park, historical, cultural, island, waterfall, reserve, museum, monument, other",
                    "Average cost must be greater than or equal to 0",
                    "Rating must be between 0 and 5"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
