# Copy this file to .env and fill in your own values. NEVER commit .env
MONGODB_URI=
PORT=3000
NODE_ENV=development

# Random string used to sign session cookies (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local:  http://localhost:3000/auth/github/callback
# Render: https://YOUR-RENDER-URL.onrender.com/auth/github/callback
GITHUB_CALLBACK_URL=
